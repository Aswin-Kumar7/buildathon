# Copy to .env for local development. Never commit .env.
# Everything here has a working default except the two key material values below. `pnpm dev`
# needs no database and no Razorpay account.

# ─────────────────────────────────────────────────────────────────────────────────────────
# Processes and origins
# ─────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=5173
STOREFRONT_PORT=5174

# Container platforms inject PORT and expect the process to listen on it. When set it wins
# over API_PORT, which stays for local development. Leave unset locally.
# PORT=

# Comma-separated, because the console and the storefront are deliberately separate origins
# and both call the API. Every deployed origin must be listed or the browser blocks the call.
WEB_ORIGIN=http://localhost:5173,http://localhost:5174

# Public address of the storefront, served to the web client at request time via /api/meta.
# This is the one that matters in a deployment: the web bundle inlines its own copy at BUILD
# time, so setting only the build variable on a container that is already built changes
# nothing and the storefront links fall back to same-origin — which is the API. Set this on
# the API container and the built page picks it up with no rebuild.
# STOREFRONT_URL=https://your-storefront.example.com

# ─────────────────────────────────────────────────────────────────────────────────────────
# Data
# ─────────────────────────────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset (or empty) to run on embedded Postgres with no server at all.
# That is the credential-free path, and it is what the end-to-end suite uses.
DATABASE_URL=

# Where the embedded database keeps its files. Unset means a temporary directory, so state
# does not survive a restart. Point it at a volume to keep a demo's data between runs.
# PGLITE_DIR=.pglite

# Only for `pnpm test:integration`, and only ever a throwaway database — the suite writes
# fixture users into whatever this points at. Deliberately not DATABASE_URL.
INTEGRATION_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────────────────
# Sessions and sign-in
# ─────────────────────────────────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Creates the published demo accounts at boot. Unset means on outside production and off in
# production: a fresh clone has to be signable-in without provisioning, and a deployment must
# never seed a documented password by accident. Set it explicitly to override either way.
# SEED_DEMO_USERS=true

# Lets the simulation and replay endpoints run under NODE_ENV=production. Off by default, and it
# should stay off for a merchant: synthetic traffic sharing a database with real traffic makes the
# deployment's own figures unquotable. The hosted demo sets it, because strangers are meant to
# drive it and nothing cites its database — every published number is generated by CI from the
# corpus, in a separate process.
# ALLOW_REPLAY_IN_PRODUCTION=true

# Whether to believe the X-Forwarded-For header. True only when the app really does sit
# behind a proxy you control; otherwise any caller can choose their own address. Accepts
# exactly true, false, 1 or 0 — anything else is rejected at startup rather than guessed at.
TRUST_PROXY=false

# ─────────────────────────────────────────────────────────────────────────────────────────
# Razorpay — test mode only. Live keys must never appear here.
# ─────────────────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# From the Razorpay dashboard when the webhook is created — you choose it, they sign with
# it. Without it the webhook endpoint refuses every delivery rather than accepting unsigned
# ones, and the system health page says so plainly.
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────────────────
# Key material. Enforced at two different moments:
#   PSEUDONYM_KEY_V1 — required to BOOT. The API will not start without it.
#   PAYLOAD_KEY_V1   — required to ACCEPT A WEBHOOK. The API starts without it, but the ingest
#                      endpoint refuses every delivery rather than storing customer data in the clear.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both must be exactly 64 hex characters. There is deliberately no default: one baked into
# the source would make every pseudonym on every install reproducible by anyone.
# ─────────────────────────────────────────────────────────────────────────────────────────
PSEUDONYM_KEY_V1=
PSEUDONYM_KEY_VERSION=1

# Wraps the per-event data keys that encrypt webhook payloads. Required to accept a webhook:
# without it the endpoint refuses the delivery rather than storing a customer's email and
# contact number in plaintext.
PAYLOAD_KEY_V1=
PAYLOAD_KEY_VERSION=1

# ─────────────────────────────────────────────────────────────────────────────────────────
# Ingestion
# ─────────────────────────────────────────────────────────────────────────────────────────
# An event arriving within ALLOWED_LATENESS_MINUTES of the watermark still updates
# aggregates; one arriving beyond it is recorded and counted but never rewrites a decision
# already taken.
ALLOWED_LATENESS_MINUTES=5
FORENSIC_RETENTION_DAYS=7
INBOX_MAX_ATTEMPTS=3
INBOX_BATCH_SIZE=50

# Drain tick. Zero disables the timer entirely, which is what the tests want.
INBOX_DRAIN_INTERVAL_MS=1000

# Keep true for the single-process local demo. Set false on the HTTP container when running
# the separate `pnpm --filter @sentinel/api start:worker` deployment alongside it.
INBOX_WORKER_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────────────────
# Narration and the AI risk manager
# ─────────────────────────────────────────────────────────────────────────────────────────
# Absent is a supported mode.
NARRATION_MODE=template

# Default 'local' runs a deterministic, fully grounded recommendation with no LLM. Set 'live'
# plus a GROQ_API_KEY to use Groq for the live tier; it still degrades to the deterministic
# local floor if Groq is slow or unreachable. The model emits claim ids only.
RISK_MANAGER_MODE=local
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ─────────────────────────────────────────────────────────────────────────────────────────
# Build stamps — set by CI, shown on the landing page footer and /api/meta
# ─────────────────────────────────────────────────────────────────────────────────────────
# APP_VERSION=
# GIT_COMMIT=

# ─────────────────────────────────────────────────────────────────────────────────────────
# Web build-time only. Vite inlines this into the bundle, so it is set where the web app is
# BUILT, not where it runs. Prefer STOREFRONT_URL above for anything already deployed.
# ─────────────────────────────────────────────────────────────────────────────────────────
# VITE_STOREFRONT_URL=http://localhost:5174
