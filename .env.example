# Copy to .env for local development. Never commit .env.
# Rotate every value after recording the demo video.

NODE_ENV=development
API_PORT=3001
WEB_PORT=5173
STOREFRONT_PORT=5174

# Leave DATABASE_URL unset (or empty) to run on embedded Postgres with no server at all.
# That is the credential-free path, and it is what the end-to-end suite uses.
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Only for `pnpm test:integration`, and only ever a throwaway database — the suite writes
# fixture users into whatever this points at. Deliberately not DATABASE_URL.
INTEGRATION_DATABASE_URL=

# Whether to believe the X-Forwarded-For header. Set this to true only when the app really
# does sit behind a proxy you control; otherwise any caller can choose their own address.
# Accepts exactly true, false, 1 or 0 — anything else is rejected at startup rather than
# guessed at.
TRUST_PROXY=false

# Razorpay test mode only. Live keys must never appear here.
# Introduced in Slice 3.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Keyed pseudonymisation (Slice 3). Versioned; see architecture plan §8.2.
# Required — the API refuses to start without it, and there is no default, because a
# fallback baked into the source would make every pseudonym reproducible by anyone.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PSEUDONYM_KEY_V1=
PSEUDONYM_KEY_VERSION=1

# Narration provider (Slice 14). Absent is a supported mode.
NARRATION_MODE=template
