# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.turbo/
*.tsbuildinfo

# test / coverage
coverage/
.vitest/
playwright-report/
test-results/

# environment — never commit real credentials
.env
.env.*
!.env.example

# data — never commit restricted datasets (see docs/DATA_CARD.md)
data/raw/
data/interim/
*.csv
*.parquet
*.zip
!fixtures/**/*.csv

# embedded database
.data/

# python
__pycache__/
.venv/
*.pyc

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

docs/

# Service-account keys and anything else shaped like a private key. These arrive as a
# download with a project-shaped filename and are easy to drop into a repository while
# wiring up a deploy — which is how they end up on GitHub. A key belongs in a secret store,
# never in a working tree.
*.pem
*.p12
*-key.json
*service-account*.json
gha-creds-*.json
project-*-*.json

# Editor and assistant scratch config, created automatically and specific to one machine.
.claude/

# The IEEE-CIS competition data is never committed — the rules forbid redistribution. The
# generated artefacts (metrics.json, model_card.md) ARE committed; only the raw data is ignored.
ml/models/transaction_risk/data/

# Model B's training data IS ours — the scenario corpus rendered to a table by
# ml/models/incident/export_training.mjs, deterministic from fixed seeds and free of any restricted
# source. Committing it is what makes `make eval` and `make check-metrics` reproduce on a clone
# without first rebuilding the TypeScript corpus. (The blanket *.csv rule above would hide it.)
!ml/models/incident/data/
!ml/models/incident/data/training.csv
__pycache__/
*.pyc
.pytest_cache/
